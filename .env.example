# Configure all hosts; no live requests are made by preview or tests.
AUTH_URL=https://auth.example.invalid/api/token
EVENTS_URL=https://events.example.invalid/events
NOTIFICATION_URL=https://notification.example.invalid/notificationapi/sendMail
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_REALM=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_GRANT_TYPE=password
ENVIRONMENT_NAME=Development
REPORT_TIMEZONE=Asia/Riyadh
REPORT_INTERVAL_DAYS=1
REPORT_TEMPLATE=template1
EVENT_PATH=contains:complaint
EVENT_APP_NAME=
# Optional supplemental diagnostic query. Never replaces the full event query.
BUSINESS_ERROR_QUERY=
PAGE_LIMIT=1000
MAIL_FROM=
MAIL_TO=
MAIL_CC=
MAIL_BCC=
ATTACHMENT_ENABLED=false
REQUEST_TIMEOUT_MS=30000
REQUEST_RETRIES=2
LOG_LEVEL=info
# Set before launching Node when corporate trust is required:
# NODE_EXTRA_CA_CERTS=C:/certificates/corporate-chain.pem
